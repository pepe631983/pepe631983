# Copie a frontend/.env.local y complete solo en su máquina (no commitear).
# Nunca use service_role ni STAGING_DATABASE_URL en el frontend.

# --- Frontend (obligatorio para npm run dev) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Pruebas E2E / Playwright (opcional, solo CI o máquina de QA) ---
PLAYWRIGHT_BASE_URL=
STAGING_UI_TEST_EMAIL=
STAGING_UI_TEST_PASSWORD=

# --- CLI Supabase / validación staging (opcional, nunca en el bundle Vite) ---
STAGING_DATABASE_URL=
STAGING_SUPABASE_PROJECT_REF=
STAGING_SUPABASE_HOST=
STAGING_ALLOW_PUSH=

# --- Deploy Firebase Hosting (opcional, CI) ---
FIREBASE_TOKEN=
