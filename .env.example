# Copie este archivo a frontend/.env.local y complete con su proyecto Supabase.
# Nunca coloque la clave service_role en el frontend.

VITE_SUPABASE_URL=https://SU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=su_clave_anon_publica

