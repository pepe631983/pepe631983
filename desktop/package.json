{
  "name": "tci-auto-zone-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TCI Auto Zone — escritorio Windows/macOS para impresión directa",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "start:dev": "TCI_APP_URL=http://localhost:5173 NODE_ENV=development electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.tcautozone.desktop",
    "productName": "TCI Auto Zone",
    "directories": { "output": "release" },
    "files": ["electron-main.cjs", "electron-preload.cjs", "../frontend/dist/**/*"],
    "extraMetadata": { "main": "electron-main.cjs" },
    "win": { "target": ["nsis"], "publisherName": "TCI Auto Zone" },
    "mac": { "target": ["dmg"], "category": "public.app-category.business" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  }
}
